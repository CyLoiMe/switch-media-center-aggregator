<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        marginTop="10"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/main/content_padding_sides"
            paddingRight="@style/main/content_padding_sides"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

            <!-- First row on purpose: it is the escape hatch for every other
                 field on this page, and the page you cannot reach with a stick is
                 the one you need the phone for. -->
            <DisclosureCell
                title="@i18n/main/setting/quick_config/header"
                id="setting/quick_config"
                marginBottom="16px" />

            <DisclosureCell
                title="@i18n/main/setting/libraries/header"
                id="setting/libraries"
                marginBottom="16px" />

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/playback/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:BooleanCell
                    id="setting/video/hwdec" />
                <brls:SelectorCell
                    id="setting/mpv/vo" />
                <brls:BooleanCell
                    id="setting/video/low_quality" />
                <brls:SelectorCell
                    id="setting/video/inmemory" />
                <brls:SelectorCell
                    id="setting/playback/audio_channels" />
                <brls:BooleanCell
                    id="setting/video/subs_fallback" />
                <brls:SelectorCell
                    id="setting/playback/subtitle_lang" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/control/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:BooleanCell
                    id="setting/player/osd_on_toggle" />
                <brls:BooleanCell
                    id="setting/player/touch_gesture" />
                <brls:BooleanCell
                    id="setting/player/tv_model" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/transcode/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <SelectorCell
                    id="setting/playback/mode" />
                <SelectorCell
                    id="setting/transcode/max_resolution" />
                <SelectorCell
                    id="setting/transcode/codec" />
                <DisclosureCell
                    id="setting/transcode/cloud_direct"
                    title="@i18n/main/setting/transcode/cloud_direct" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/network/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:SelectorCell
                    id="setting/network/threads" />
                <brls:SelectorCell
                    id="setting/network/timeout" />
                <!-- LAN vs WAN fallback policy for connections that declare both
                     addresses (utils/dual_url.hpp). -->
                <brls:SelectorCell
                    id="setting/network/wan_policy" />
                <!-- How long the home address may take to answer before the
                     metered one is used (WAN_PROBE_MS). -->
                <brls:SelectorCell
                    id="setting/network/probe_timeout" />
                <brls:BooleanCell
                    id="setting/network/proxy_status" />
                <brls:InputCell
                    id="setting/network/proxy"
                    visibility="gone" />
                <brls:InputCell
                    id="setting/network/proxy_user"
                    visibility="gone" />
                <brls:InputCell
                    id="setting/network/proxy_passwd"
                    type="password"
                    visibility="gone" />
                <brls:InputCell
                    id="setting/network/user_agent" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/ui/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:BooleanCell
                    id="setting/player/clip_point" />
                <brls:BooleanCell
                    id="setting/ui/show_fps" />
                <SelectorCell
                    id="setting/ui/vsync" />
                <SelectorCell
                    id="setting/ui/scale" 
                    quitApp="true" />
                <SelectorCell
                    id="setting/keymap"
                    quitApp="true" />
                <SelectorCell
                    id="setting/ui/theme"
                    quitApp="true" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/tutorial/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:RadioCell
                    id="tools/tutorial_open"
                    title="@i18n/main/setting/tutorial/open" />
                <brls:RadioCell
                    id="tools/tutorial_error"
                    title="@i18n/main/setting/tutorial/error" />
                <brls:RadioCell
                    id="tools/tutorial_font"
                    title="@i18n/main/setting/tutorial/font" />
                <brls:RadioCell
                    id="tools/config_dir"
                    title="@i18n/main/setting/others/config_dir" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/main/setting/others/header"
                marginBottom="0px" />
            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="30px">
                <brls:BooleanCell
                    id="setting/overclock" />
                <brls:BooleanCell
                    id="setting/sync" />
                <SelectorCell
                    id="setting/language"
                    quitApp="true" />
                <brls:BooleanCell
                    id="setting/debug" />
                <brls:RadioCell
                    id="setting/release_checker" />
                <brls:RadioCell
                    id="setting/changelog"
                    title="@i18n/main/setting/others/changelog" />
                <DisclosureCell
                    title="@i18n/main/about/header"
                    id="setting/about" />
            </brls:Box>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>